{
  "name": "brutus-desktop",
  "version": "1.4.0",
  "description": "Brutus AI - Real-time AI Sales Coach",
  "author": "Brutus AI",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "build": "electron-builder --config electron-builder.config.js",
    "build:win": "electron-builder --win --config electron-builder.config.js",
    "build:mac": "electron-builder --mac --config electron-builder.config.js",
    "build:linux": "electron-builder --linux --config electron-builder.config.js"
  },
  "build": {
    "appId": "coach.brutusai",
    "productName": "Brutus AI",
    "icon": "assets/icon.png",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Brutus uses your microphone to hear your side of the call for live coaching.",
        "NSAudioCaptureUsageDescription": "Brutus records the call audio playing on your computer so it can coach on both sides of the conversation."
      },
      "category": "public.app-category.business",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "notarize": false
    },
    "linux": {
      "target": "AppImage"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "TurnkeyIsaiah",
      "repo": "Brutus"
    }
  },
  "dependencies": {
    "animejs": "4.5.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "koffi": "^2.16.3",
    "posthog-js": "^1.435.4"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.17.0",
    "playwright-core": "^1.63.0"
  }
}
